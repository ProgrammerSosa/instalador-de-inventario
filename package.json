{
  "name": "instalador-de-inventario",
  "version": "1.0.0",
  "description": "Sistema de inventario para Librería y Limpieza",
  "main": "electron/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:frontend": "npm run build --prefix frontend",
    "start": "npm run build:frontend && electron .",
    "dist": "npm run build:frontend && electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProgrammerSosa/instalador-de-inventario.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ProgrammerSosa/instalador-de-inventario/issues"
  },
  "homepage": "https://github.com/ProgrammerSosa/instalador-de-inventario#readme",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.programmersosa.inventario",
    "productName": "Inventario",
    "icon": "build/icon.png",
    "npmRebuild": false,
    "files": [
      "electron/**/*",
      "backend/**/*",
      "!backend/node_modules/**/*",
      "!backend/data/**/*",
      "!backend/**/*.test.js",
      "frontend/dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    }
  }
}
